# Copy to .env and fill in. Never commit .env.

# Optional. Without it the app runs on the deterministic demo model.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# auto (default): Claude when the key above is set, demo model otherwise | fake | anthropic
SOURCEBOOK_PROVIDER=auto
SOURCEBOOK_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
SOURCEBOOK_EFFORT=medium

SOURCEBOOK_DATABASE_PATH=data/sourcebook.db
SOURCEBOOK_SEED_SAMPLES=true
SOURCEBOOK_HOST=127.0.0.1
SOURCEBOOK_PORT=8000
